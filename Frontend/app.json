{
  "expo": {
    "name": "Frontend",
    "slug": "Frontend",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/systemicons/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/systemicons/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/systemicons/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.rn.expo.Frontend"
    },
    "web": {
      "favicon": "./assets/systemicons/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "7a2537d6-cf0f-4c4f-a2cf-a2a91c51f47c"
      }
    },
    "plugins": [
      "expo-font"
    ]
  }
}
